{
  "mcpServers": {
    "tidb": {
      "command": "uvx",
      "args": ["--from", "pytidb[mcp]", "tidb-mcp-server"],
      "env": { "TIDB_HOST": "${TIDB_HOST}", "TIDB_PORT": "4000", "TIDB_USERNAME": "${TIDB_USER}", "TIDB_PASSWORD": "${TIDB_PASSWORD}", "TIDB_DATABASE": "airportdb" },
      "disabled": false,
      "autoApprove": ["show_databases", "show_tables", "db_query"]
    }
  }
}
