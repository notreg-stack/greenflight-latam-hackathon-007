# ===== GreenFlight · time latam-hackathon-007 =====
# Copie para backend/.env (git-ignored). Nunca commite este arquivo preenchido.

# --- TiDB Cloud Starter (AWS · São Paulo sa-east-1) ---
# Console tidbcloud.com → cluster → Connect → Public Endpoint. Vazio = modo local (SQLite com o dump oficial).
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=airportdb
# opcional: caminho do CA se o padrão do sistema não servir (mac: /etc/ssl/cert.pem · EC2: /etc/pki/tls/certs/ca-bundle.crt)
TIDB_SSL_CA=

# --- Amazon Bedrock (Singapura ap-southeast-1, de propósito) ---
# Opção A: par de chaves da tabela "Bedrock API Keys" do documento de credenciais (linha latam-hackathon-007)
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
# Desenvolvimento local: use o perfil AWS já configurado em vez de copiar chaves para este arquivo.
# AWS_PROFILE=tidb-hackathon-007
# Opção B: bearer token, se a organização entregar nesse formato
# AWS_BEARER_TOKEN_BEDROCK=   (só se a organização entregar bearer token; deixe comentado se usar o par de chaves)
AWS_REGION=ap-southeast-1

# --- S3 do time (só funciona na EC2, pela role da instância; fora da AWS é ignorado) ---
GREENFLIGHT_S3_PREFIX=s3://tidb-latam-hackathon-2026-048364544505/latam-hackathon-007/
