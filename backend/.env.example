# TiDB Cloud Starter (sa-east-1) — deixe TIDB_HOST vazio para rodar em modo local (SQLite com o dump oficial)
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=airportdb
# Bedrock (Singapura) — chave do time
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=ap-southeast-1
# S3 do time (só funciona na EC2, pela role da instância)
GREENFLIGHT_S3_PREFIX=s3://tidb-latam-hackathon-2026-048364544505/latam-hackathon-007/
